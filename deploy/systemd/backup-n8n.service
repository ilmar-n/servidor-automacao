[Unit]
Description=Backup do n8n (restic -> Cloudflare R2)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
# Roda como root: data/n8n pertence ao uid 1000 (usuário do container do n8n)
WorkingDirectory=/home/ubuntu/servidor-automacao
ExecStart=/home/ubuntu/servidor-automacao/scripts/backup.sh
Nice=10
IOSchedulingClass=idle
