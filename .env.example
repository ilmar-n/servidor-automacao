# Copie para .env com scripts/gerar-env.sh (gera os segredos sozinho).
# NUNCA suba o .env para o Git. Guarde uma cópia no gerenciador de senhas:
# sem a N8N_ENCRYPTION_KEY, as credenciais salvas no n8n não abrem depois de restaurar.

# Versões fixas (atualizar com backup antes)
N8N_VERSION=2.46.6
POSTGRES_VERSION=16.15-alpine

# Domínio público do n8n
N8N_HOST=n8n.exemplo.com.br
N8N_LOCAL_PORT=5678

# Banco
POSTGRES_USER=n8n
POSTGRES_DB=n8n
POSTGRES_PASSWORD=TROCAR

# Segredos do n8n
N8N_ENCRYPTION_KEY=TROCAR
N8N_RUNNERS_AUTH_TOKEN=TROCAR
