# Site do n8n atrás do nginx da máquina. Troque N8N_HOST pelo domínio.
# Instalação:
#   sudo cp deploy/nginx/n8n.conf.example /etc/nginx/sites-available/n8n.conf
#   sudo sed -i 's/N8N_HOST/n8n.seudominio.com.br/' /etc/nginx/sites-available/n8n.conf
#   sudo ln -s /etc/nginx/sites-available/n8n.conf /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d n8n.seudominio.com.br     # adiciona o HTTPS e o redirect
server {
    listen 80;
    listen [::]:80;
    server_name N8N_HOST;

    client_max_body_size 50m;

    location / {
        # Liberação temporária: só o seu IP até criar o usuário dono no n8n.
        # Depois de criar o dono, apague as duas linhas abaixo e recarregue o nginx.
        allow SEU_IP;
        deny all;

        proxy_pass http://127.0.0.1:5678;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;     # WebSocket (editor em tempo real)
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
    }
}
